# Copy to .env.local and fill in. Vite reads these at startup, so restart the
# dev server after changing them.

# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push. Generate a pair with:  npx web-push generate-vapid-keys
# The public key goes here; the private key goes in the Edge Function's secrets
# (VAPID_PRIVATE_KEY) and must never be committed.
VITE_VAPID_PUBLIC_KEY=

# Spotify. Client ID of an app from https://developer.spotify.com/dashboard.
# There is no client secret: the app uses PKCE, which a browser can do safely.
#
# Register BOTH redirect URIs on the Spotify app:
#   https://<your-domain>/spotify/callback
#   http://127.0.0.1:5173/spotify/callback
#
# Spotify rejects "localhost" in redirect URIs — loopback must be the literal
# IP. So for local testing, browse to 127.0.0.1:5173, not localhost:5173.
VITE_SPOTIFY_CLIENT_ID=
